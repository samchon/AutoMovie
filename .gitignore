.claude/
.discussions/
# disposable workspace-linked sandboxes (`pnpm run experimental <name>`)
experimental/
.models/
.wiki/
.references/

node_modules/
lib/
dist/

.DS_Store
*.tsbuildinfo
.env
.env.*
# fetched/generated model assets (VRM samples, the baked MakeHuman GLB)
packages/playground/public/models/*
# generated MakeHuman head render OBJs (reproduce via scripts/mh/mh_export_head.py)
packages/playground/public/mh/

# local screenshot scratch (not committed)
.shots/

# scratch face-probe pages (head.html is the kept editor)
packages/playground/mh.html
packages/playground/cf.html
packages/playground/montage-three.png
# keep the parametric head model data (generated, but the editor needs it)
!packages/playground/public/models/head-model.json

# transpiled output that lands beside a source rather than in `lib/`
packages/*/src/**/*.js
packages/*/src/**/*.js.map
# the scaffold nests a whole project, so its own sources need the same rule
packages/cli/scaffold/src/**/*.js
packages/cli/scaffold/src/**/*.js.map
packages/cli/scaffold/scripts/**/*.js
packages/cli/scaffold/scripts/**/*.js.map
