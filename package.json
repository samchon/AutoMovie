{
  "private": true,
  "name": "@automovie/station",
  "version": "0.1.0",
  "description": "Coding-agent-native deterministic filmmaking: tracked authoring, compilation, rendering, review, and delivery.",
  "packageManager": "pnpm@10.6.4",
  "scripts": {
    "build": "pnpm --filter=./docs --filter=./packages/** -r build",
    "build:tgz": "ttsx -P config/tsconfig.json --no-plugins --types node build/tgz.ts",
    "test": "pnpm --filter @automovie/test build && pnpm --filter @automovie/test start",
    "experimental": "ttsx -P config/tsconfig.json --no-plugins --types node build/experimental.ts --",
    "format": "prettier --write \"**/*.{ts,cts,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,cts,mts}\"",
    "lint:voice": "ttsx -P config/tsconfig.json --no-plugins --types node build/proseVoice-cli.ts",
    "probe:scaffold-parent": "ttsx -P config/tsconfig.json --no-plugins --types node build/probeScaffoldParentPublication.ts"
  },
  "keywords": [
    "coding-agent",
    "deterministic",
    "filmmaking",
    "animation",
    "rendering"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "catalog:typescript",
    "@ttsc/evidence": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript",
    "@types/node": "catalog:utils",
    "prettier": "catalog:typescript",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript-compiler": "npm:typescript@5.9.3",
    "typescript": "catalog:typescript"
  }
}
