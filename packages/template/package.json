{
  "name": "@automovie/template",
  "version": "0.1.0",
  "description": "The scaffold every AutoMovie production is created from, the shared contracts its evidence graph cites, and the library that materializes both.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "pnpm run build:versions",
    "build:versions": "node build/sync-versions.mjs",
    "build": "pnpm run build:versions && rimraf lib && ttsc && tsc --emitDeclarationOnly",
    "postbuild": "node ../../config/assertBuild.js",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "automovie",
    "scaffold",
    "template"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "build",
    "docs",
    "lib",
    "scaffold",
    "src",
    "package.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./docs/*": "./docs/*",
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@automovie/archetypes": "workspace:^",
    "@automovie/engine": "workspace:^",
    "@automovie/evidence": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/mcp": "workspace:^",
    "@automovie/render": "workspace:^",
    "@automovie/viewer": "workspace:^",
    "@ttsc/evidence": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "three": "catalog:three",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript"
  }
}
