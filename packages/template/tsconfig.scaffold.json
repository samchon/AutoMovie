{
  // Check the same source and options as a generated project.
  // The overrides resolve this package itself and the repository lint origin.
  "extends": "./scaffold/package.json",
  "compilerOptions": {
    "noEmit": true,
    "plugins": [
      { "transform": "@ttsc/lint", "configFile": "./scaffold/src/lint.config.ts" }
    ],
    "paths": {
      "@automovie/template": ["./src/index.ts"]
    }
  }
}
