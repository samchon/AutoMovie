{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "description": "An AutoMovie coding-agent production repository.",
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "file:vendor/sharp-disabled"
    }
  },
  "scripts": {
    "capture:doctor": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/capture-doctor.ts",
    "capture:install": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/capture-install.ts",
    "build": "npm run compile",
    "compile": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/compile.ts",
    "lint": "npm run lint:source && ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/lint.ts",
    "lint:source": "ttsc --cache-dir node_modules/.cache/ttsc --noEmit -p tsconfig.json",
    "preview": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/preview.ts",
    "render": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/render.ts",
    "viewer": "vite --host 127.0.0.1",
    "test": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json test/scaffold.test.ts",
    "verify": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/verify.ts",
    "format": "ttsc format --cache-dir node_modules/.cache/ttsc -p tsconfig.json",
    "design": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/emitDesign.ts",
    "derive:example": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/deriveExampleArtifact.ts",
    "building:report": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/deriveBuilding.ts",
    "texture:scale": "ttsx --cache-dir node_modules/.cache/ttsc -P tsconfig.json scripts/measureTextureScale.ts"
  },
  "dependencies": {
    "@automovie/archetypes": "{{version:archetypes}}",
    "automovie": "{{version:cli}}",
    "@automovie/engine": "{{version:engine}}",
    "@automovie/interface": "{{version:interface}}",
    "@automovie/mcp": "{{version:mcp}}",
    "@automovie/render": "{{version:render}}",
    "@automovie/viewer": "{{version:viewer}}",
    "@huggingface/transformers": "{{version:huggingFaceTransformers}}",
    "h264-mp4-encoder": "{{version:h264Mp4Encoder}}",
    "kokoro-js": "{{version:kokoroJs}}",
    "libopus-wasm": "{{version:libopusWasm}}",
    "mp4box": "{{version:mp4box}}",
    "onnxruntime-node": "{{version:onnxruntimeNode}}",
    "pngjs": "{{version:pngjs}}",
    "sharp": "file:vendor/sharp-disabled",
    "three": "{{version:three}}"
  },
  "devDependencies": {
    "@automovie/evidence": "{{version:evidence}}",
    "@automovie/template": "{{version:template}}",
    "@ttsc/lint": "{{version:ttscLint}}",
    "@types/node": "{{version:nodeTypes}}",
    "@types/pngjs": "{{version:pngjsTypes}}",
    "@types/three": "{{version:threeTypes}}",
    "playwright": "{{version:playwright}}",
    "ttsc": "{{version:ttsc}}",
    "typescript": "{{version:typescript}}",
    "vite": "{{version:vite}}"
  }
}
