{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "newLine": "lf",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "scripts",
    "vendor/sharp-disabled/index.ts",
    "viewer/src",
    "repaintSelectionReviews.ts",
    "vite.config.ts",
    "lint.config.ts"
  ]
}
