{
  "name": "@automovie/interface",
  "version": "0.1.0",
  "description": "AutoMovie type contracts for code-native authoring, deterministic film data, production evidence, review, and delivery.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc && tsc --emitDeclarationOnly",
    "postbuild": "node ../../config/assertBuild.js",
    "prepack": "pnpm run build"
  },
  "keywords": ["animation", "filmmaking", "production", "typescript", "types"],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript"
  }
}
