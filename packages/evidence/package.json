{
  "name": "@automovie/evidence",
  "version": "0.1.0",
  "description": "Production-kind-aware AutoMovie evidence graph construction and validation.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc && tsc --emitDeclarationOnly",
    "prepack": "pnpm run build",
    "test": "ttsx --no-plugins -P tsconfig.test.json test/index.ts"
  },
  "keywords": ["automovie", "evidence", "traceability"],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": ["lib", "src", "package.json", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@ttsc/evidence": "catalog:typescript",
    "typescript-compiler": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@ttsc/lint": "catalog:typescript",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript"
  }
}
