{
  "name": "automovie",
  "version": "0.1.0",
  "description": "Scaffold and inspect a coding-agent-first AutoMovie production repository.",
  "main": "src/index.ts",
  "bin": {
    "automovie": "lib/bin.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc && tsc --emitDeclarationOnly",
    "start": "ttsx src/bin.ts",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "automovie",
    "cli",
    "sdk",
    "project-state",
    "scaffold",
    "starter",
    "create"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": ["lib", "src", "package.json", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "bin": {
      "automovie": "lib/bin.js"
    },
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/evidence": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/production": "workspace:^",
    "@automovie/template": "workspace:^",
    "typia": "catalog:samchon"
  },
  "devDependencies": {
    "@automovie/viewer": "workspace:^",
    "@ttsc/evidence": "catalog:typescript",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "three": "catalog:three",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript"
  }
}
