{
  "name": "@automovie/archetypes",
  "version": "0.1.0",
  "description": "automovie primitive model archetype catalogue: parameter schemas, bounds, and deterministic geometry builders behind one registry",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc && tsc --emitDeclarationOnly",
    "postbuild": "node ../../internals/config/assertBuild.js",
    "prepack": "pnpm run build"
  },
  "keywords": [],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": ["lib", "src", "package.json", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript",
    "@ttsc/evidence": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript"
  },
  "dependencies": {
    "@automovie/engine": "workspace:^",
    "@automovie/interface": "workspace:^"
  }
}
