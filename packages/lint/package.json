{
  "name": "@automovie/lint",
  "version": "0.1.0",
  "description": "AutoMovie project-contract rules for @ttsc/lint.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && tsc",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "automovie",
    "ttsc",
    "lint"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "native",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@ttsc/lint": ">=0.23.0"
  },
  "devDependencies": {
    "@types/node": "catalog:utils",
    "@ttsc/lint": "catalog:typescript",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript"
  }
}
