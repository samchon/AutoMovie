{
  "name": "@automovie/mcp",
  "version": "0.1.0",
  "description": "AutoMovie production library: the deterministic compiler, the tracked project store, capture, inspection, and the render job.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "pnpm run build:prompt",
    "build:prompt": "node build/prompt.mjs",
    "build": "pnpm run build:prompt && rimraf lib && ttsc && tsc --emitDeclarationOnly",
    "postbuild": "node ../../config/assertBuild.js",
    "start": "ttsx src/bin.ts",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "evidence",
    "review",
    "filmmaking"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": ["lib", "src", "package.json", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "bin": {
      "automovie-mcp": "lib/bin.js"
    },
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@automovie/archetypes": "workspace:^",
    "@automovie/engine": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/render": "workspace:^",
    "@typia/mcp": "catalog:samchon",
    "mp4box": "catalog:media",
    "pngjs": "catalog:media",
    "typia": "catalog:samchon",
    "typescript-compiler": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@types/node": "catalog:utils",
    "@types/pngjs": "catalog:media",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript"
  }
}
