{
  "name": "@automovie/production",
  "version": "0.1.0",
  "description": "AutoMovie production assembly, tracked project storage, capture, inspection, and rendering.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "automovie",
    "production",
    "evidence",
    "filmmaking"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/automovie"
  },
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@automovie/archetypes": "workspace:^",
    "@automovie/evidence": "workspace:^",
    "@automovie/engine": "workspace:^",
    "@automovie/ingest": "workspace:^",
    "@automovie/interface": "workspace:^",
    "@automovie/render": "workspace:^",
    "mp4box": "catalog:media",
    "pngjs": "catalog:media",
    "typia": "catalog:samchon"
  },
  "devDependencies": {
    "@types/node": "catalog:utils",
    "@types/pngjs": "catalog:media",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript"
  }
}
